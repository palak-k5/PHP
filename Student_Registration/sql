//sql code from student reegistration Form



$student_table="CREATE TABLE if not exists student_info (
    student_id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100),
    email VARCHAR(100) UNIQUE,password VARCHAR(20),
    age INT,
    gender ENUM('male','female'),
    course varchar(60),dob DATE,address varchar(200)
)";

if ($conn->query($student_table) === TRUE) {
    echo "Table student_info created"."<br>";
}
