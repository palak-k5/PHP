$skills_table="CREATE TABLE  if not exists skills (skill_id INT PRIMARY KEY AUTO_INCREMENT, skill_name VARCHAR(100))";

if ($conn->query($skills_table) === TRUE) {
    echo "Table skills created"."<br>";
} 
