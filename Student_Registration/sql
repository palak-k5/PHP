$mapping="CREATE TABLE if not exists student_skills (id INT PRIMARY KEY AUTO_INCREMENT,student_id INT,skill_id INT,
    FOREIGN KEY (student_id) REFERENCES student_info(student_id),
    FOREIGN KEY (skill_id) REFERENCES skills(skill_id)
)";

if ($conn->query($mapping) === TRUE) {
    echo "Table mapping (student_skills) created"."<br>";
} 
